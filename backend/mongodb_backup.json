    "faqs": [
      {
        "_id": "6abfeb356ef1fe1ec92e83e7",
        "id": "eac002e0-7928-40d5-9d47-a1d8a807ded0",
        "question": "What is a DSC?",
        "answer": "A Digital Signature Certificate (DSC) is the electronic equivalent of a physical signature, legally valid under the IT Act 2000, used to sign documents and authenticate identity online.",
        "active": true,
        "sortOrder": 1,
        "createdAt": "2026-10-02T17:34:45.038629+00:00"
      },
      {
        "_id": "6abfeb356ef1fe1ec92e83e8",
        "id": "9c4290e3-b4d4-4650-9207-24b63b8f443a",
        "question": "Which DSC do I need?",
        "answer": "It depends on your purpose. Use our DSC Finder to get a personalised recommendation based on whether you are an individual, business, exporter or bidding on tenders.",
        "active": true,
        "sortOrder": 2,
        "createdAt": "2026-10-02T17:34:45.358314+00:00"
      },
      {
        "_id": "6abfeb356ef1fe1ec92e83e9",
        "id": "3ccead06-0357-435b-ba93-607d2bbca312",
        "question": "What documents are required?",
        "answer": "Typically PAN, Aadhaar, a photograph and address proof for individuals. Organizations need additional company documents. Exact requirements are shown per product.",
        "active": true,
        "sortOrder": 3,
        "createdAt": "2026-10-02T17:34:45.678320+00:00"
      },
      {
        "_id": "6abfeb366ef1fe1ec92e83ea",
        "id": "b31e0c0c-396c-41bb-9c48-1b993d4cc6fa",
        "question": "How long does processing take?",
        "answer": "Most Class 3 DSCs are processed within a few hours to 24 hours after successful eKYC and document verification.",
        "active": true,
        "sortOrder": 4,
        "createdAt": "2026-10-02T17:34:46.000542+00:00"
      },
      {
        "_id": "6abfeb366ef1fe1ec92e83eb",
        "id": "b7ae9a4b-0d09-4d33-a989-117e9e7a4fe0",
        "question": "Can I use DSC for GST?",
        "answer": "Yes. A Class 3 Individual DSC can be used for GST registration and return filing.",
        "active": true,
        "sortOrder": 5,
        "createdAt": "2026-10-02T17:34:46.316882+00:00"
      },
      {
        "_id": "6abfeb366ef1fe1ec92e83ec",
        "id": "5edeeb23-38b0-4e1b-a26e-b9077a466a97",
        "question": "Can I use DSC for MCA?",
        "answer": "Yes. Directors and professionals use Class 3 / MCA DSC for MCA-21 and ROC filings.",
        "active": true,
        "sortOrder": 6,
        "createdAt": "2026-10-02T17:34:46.639090+00:00"
      },
      {
        "_id": "6abfeb366ef1fe1ec92e83ed",
        "id": "d09a28f9-463c-4cf0-bd68-94c248e33a5e",
        "question": "Can I use DSC for Income Tax?",
        "answer": "Yes. DSCs are accepted for Income Tax e-Filing for individuals and organizations.",
        "active": true,
        "sortOrder": 7,
        "createdAt": "2026-10-02T17:34:46.960180+00:00"
      },
      {
        "_id": "6abfeb376ef1fe1ec92e83ee",
        "id": "c8820ddb-5436-4bd3-aca9-01ffb40a6aa9",
        "question": "Can I use DSC for eTender?",
        "answer": "Yes, our eTender DSC includes signing and encryption for government procurement portals and GeM.",
        "active": true,
        "sortOrder": 8,
        "createdAt": "2026-10-02T17:34:47.282107+00:00"
      },
      {
        "_id": "6abfeb376ef1fe1ec92e83ef",
        "id": "1547807b-94c3-4e0d-9fc6-0151519f8be0",
        "question": "What happens after document upload?",
        "answer": "Our team verifies your documents. If anything is unclear you will be asked to re-upload. Once verified, the DSC is submitted to the Certifying Authority.",
        "active": true,
        "sortOrder": 9,
        "createdAt": "2026-10-02T17:34:47.609755+00:00"
      },
      {
        "_id": "6abfeb376ef1fe1ec92e83f0",
        "id": "e39d6467-4f9c-4f0f-9926-3b15972579b0",
        "question": "How do I track my order?",
        "answer": "Log in to your dashboard to see a live timeline of your order from payment to DSC issuance and token dispatch.",
        "active": true,
        "sortOrder": 10,
        "createdAt": "2026-10-02T17:34:47.949495+00:00"
      },
      {
        "_id": "6abfeb386ef1fe1ec92e83f1",
        "id": "2c7f37e1-334c-45dd-8c84-5ec6c0e62327",
        "question": "What happens if my document is rejected?",
        "answer": "You will see the rejection reason in your dashboard and can re-upload the corrected document immediately.",
        "active": true,
        "sortOrder": 11,
        "createdAt": "2026-10-02T17:34:48.558430+00:00"
      },
      {
        "_id": "6abfeb396ef1fe1ec92e83f2",
        "id": "98afa8cb-8bd5-4d3e-9569-22cdc09798e1",
        "question": "How does Razorpay payment work?",
        "answer": "Payments are processed securely via Razorpay. Your order is only marked paid after server-side verification of the payment signature.",
        "active": true,
        "sortOrder": 12,
        "createdAt": "2026-10-02T17:34:49.199953+00:00"
      },
      {
        "_id": "6abfeb396ef1fe1ec92e83f3",
        "id": "0b8e008c-adb2-4df4-ae10-fe08bf396df1",
        "question": "How can I renew my DSC?",
        "answer": "From the My DSCs section in your dashboard, click Renew on any expiring certificate to start a fast-track renewal.",
        "active": true,
        "sortOrder": 13,
        "createdAt": "2026-10-02T17:34:49.869402+00:00"
      }
